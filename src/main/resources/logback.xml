<?xml version="1.0" encoding="UTF-8"?>
<!-- HikariCP logs through SLF4J. Without this file Logback prints every DEBUG line to the
     console, which buries the programs' own output. Warnings and errors still go to standard error. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
